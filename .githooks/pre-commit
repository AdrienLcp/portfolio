#!/usr/bin/env sh
set -e

files_per_windows_command_line=40

staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|mjs|json|css|scss)$' || true)

if [ -z "$staged" ]; then
  exit 0
fi

echo "$staged" | xargs -n "$files_per_windows_command_line" pnpm biome check --write --no-errors-on-unmatched

echo "$staged" | xargs -n "$files_per_windows_command_line" git add
