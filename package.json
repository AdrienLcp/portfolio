{
  "author": "Adrien Lacourpaille",
  "dependencies": {
    "@adrienlcp/i18n": "workspace:*",
    "@adrienlcp/result": "workspace:*",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@react-aria/optimize-locales-plugin": "^2.0.2",
    "@types/node": "^26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxc-transform-react": "^0.151.0",
    "sass": "^1.105.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "~8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "name": "portfolio",
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "private": true,
  "scripts": {
    "build": "pnpm typecheck && vite build",
    "deps:upgrade": "corepack use pnpm@latest && pnpm -r up -L && biome migrate --write",
    "dev": "vite",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "preinstall": "git config core.hooksPath .githooks || true",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "toolkit:check": "node --import tsx scripts/toolkit.ts --check",
    "toolkit:sync": "node --import tsx scripts/toolkit.ts",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm toolkit:check && pnpm build && pnpm lint:ci && pnpm test"
  },
  "type": "module",
  "version": "0.1.0"
}
