    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "cspell": "^10.4.0",
    "fontaine": "^1.0.3",
    "lighthouse": "^13.6.0",
    "linkedom": "^0.18.15",
    "oxc-transform-react": "^0.156.0",
    "playwright": "~1.64.1",
    "postcss": "^8.5.33",
    "sass": "^1.107.1",
    "shiki": "^4.6.0",
    "sitemap": "^10.0.0",
    "storybook": "^10.6.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "~8.3.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "name": "portfolio",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "private": true,
  "scripts": {
    "build": "pnpm typecheck && pnpm build:client && pnpm build:ssr && pnpm prerender",
    "build-storybook": "storybook build",
    "build:client": "vite build",
    "build:pages": "pnpm build && storybook build --quiet --output-dir dist/storybook",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "coverage:read": "node --import tsx scripts/read-test-coverage.ts",
    "cv:pdf": "node --import tsx scripts/cv-pdf.ts",
    "deps:upgrade": "corepack use pnpm@latest && pnpm -r up -L && biome migrate --write",
    "dev": "vite",
    "lighthouse": "node --import tsx scripts/lighthouse.ts",
    "lighthouse:quick": "node --import tsx scripts/lighthouse.ts --quick",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "prerender": "node --import tsx scripts/prerender.ts",
    "preview": "vite preview",
    "share:images": "node --import tsx scripts/share-images.ts",
    "spell": "cspell --no-progress --gitignore \"**\"",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run --project unit",
    "test:components": "vitest run --project stories",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "tsc --noEmit -p e2e && playwright test -c e2e",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm lint:ci && pnpm spell && pnpm build && pnpm test:coverage && pnpm test:components && pnpm test:e2e"
  },
  "type": "module",
  "version": "0.1.0"
}
