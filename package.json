{
  "author": "Adrien Lacourpaille",
  "dependencies": {
    "@adrienlcp/browser": "^0.1.1",
    "@adrienlcp/i18n": "^0.1.2",
    "@adrienlcp/react": "^0.2.0",
    "@adrienlcp/react-aria": "^0.1.0",
    "@adrienlcp/react-router": "^0.1.0",
    "@adrienlcp/result": "^0.1.0",
    "@adrienlcp/safe-storage": "^0.1.0",
    "@adrienlcp/styles": "^0.2.0",
    "@adrienlcp/theme-preference": "^0.3.0",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@adrienlcp/biome-config": "^0.1.0",
    "@adrienlcp/tsconfig": "^0.1.0",
    "@biomejs/biome": "2.5.14",
    "@cspell/dict-fr-fr": "^2.3.2",
    "@playwright/test": "~1.63.0",
    "@react-aria/optimize-locales-plugin": "^2.0.2",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "lighthouse": "^13.5.0",
    "oxc-transform-react": "^0.151.0",
    "playwright": "~1.63.0",
    "sass": "^1.105.0",
    "storybook": "^10.6.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "~8.3.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "name": "portfolio",
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "private": true,
  "scripts": {
    "build": "pnpm typecheck && pnpm build:client && pnpm build:ssr && pnpm prerender",
    "build-storybook": "storybook build",
    "build:client": "vite build",
    "build:pages": "pnpm build && storybook build --quiet --output-dir dist/storybook",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "coverage:read": "node --import tsx scripts/read-test-coverage.ts",
    "cv:pdf": "node --import tsx scripts/cv-pdf.ts",
    "deps:upgrade": "corepack use pnpm@latest && pnpm -r up -L && biome migrate --write",
    "dev": "vite",
    "lighthouse": "node --import tsx scripts/lighthouse.ts",
    "lighthouse:quick": "node --import tsx scripts/lighthouse.ts --quick",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "preinstall": "git config core.hooksPath .githooks || true",
    "prerender": "node --import tsx scripts/prerender.ts",
    "preview": "vite preview",
    "share:images": "node --import tsx scripts/share-images.ts",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run --project unit",
    "test:components": "vitest run --project stories",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "tsc --noEmit -p e2e && playwright test -c e2e",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm build && pnpm lint:ci && pnpm test:coverage && pnpm test:components && pnpm test:e2e"
  },
  "type": "module",
  "version": "0.1.0"
}
