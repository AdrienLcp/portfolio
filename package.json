{
  "author": "Adrien Lacourpaille",
  "dependencies": {
    "@adrienlcp/i18n": "^0.1.0",
    "@adrienlcp/result": "^0.1.0",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-router": "^8.4.0",
    "simple-icons": "^16.33.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "~1.63.0",
    "@react-aria/optimize-locales-plugin": "^2.0.2",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "lighthouse": "^13.5.0",
    "oxc-transform-react": "^0.151.0",
    "playwright": "~1.63.0",
    "sass": "^1.105.0",
    "storybook": "^10.6.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "~8.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "name": "portfolio",
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "private": true,
  "scripts": {
    "build": "pnpm typecheck && pnpm build:client && pnpm build:ssr && pnpm prerender",
    "build-storybook": "storybook build",
    "build:client": "vite build",
    "build:pages": "pnpm build && storybook build --quiet --output-dir dist/storybook",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "cv:pdf": "node --import tsx scripts/cv-pdf.ts",
    "deps:upgrade": "corepack use pnpm@latest && pnpm -r up -L && biome migrate --write",
    "dev": "vite",
    "lighthouse": "node --import tsx scripts/lighthouse.ts",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "preinstall": "git config core.hooksPath .githooks || true",
    "prerender": "node --import tsx scripts/prerender.ts",
    "preview": "vite preview",
    "share:images": "node --import tsx scripts/share-images.ts",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run --project unit",
    "test:components": "vitest run --project stories",
    "test:e2e": "tsc --noEmit -p e2e && playwright test -c e2e",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm build && pnpm lint:ci && pnpm test && pnpm test:components && pnpm test:e2e"
  },
  "type": "module",
  "version": "0.1.0"
}
